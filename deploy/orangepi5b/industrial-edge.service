[Unit]
Description=Industrial Edge Predictive Maintenance Collector
After=multi-user.target

[Service]
Type=simple
ExecStart=/opt/industrial-edge/bin/edge_collector --input /dev/ttyS4 --baud 115200
Restart=on-failure
RestartSec=2
User=industrial-edge
Group=dialout

[Install]
WantedBy=multi-user.target
